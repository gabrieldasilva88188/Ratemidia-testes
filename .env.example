# Copie para .env.local e preencha. NUNCA commite credenciais reais.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# TMDB (Filmes e Séries) - exige conta gratuita: https://www.themoviedb.org/settings/api
# Use UM dos dois (o token de leitura tem prioridade):
TMDB_API_READ_TOKEN=seu-token-de-acesso-de-leitura
TMDB_API_KEY=sua-chave-v3

# Jikan (Animes/Mangás) não exige chave.
